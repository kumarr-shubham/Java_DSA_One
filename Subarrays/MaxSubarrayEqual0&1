class Solution {
    public int findMaxLength(int[] arr) {
        HashMap <Integer, Integer> map = new HashMap<>();
        int n = arr.length;
        int zero = 0;
        int one = 0;
        int maxLength = 0;
        map.put(0, -1);
        for(int i=0; i<n; i++){
            if(arr[i] == 0) zero++;
            else one++;
            int diff = zero-one;
            // if(diff==0){
            //      maxLength = Math.max(maxLength, i+1);
            //      continue;
            // }
             if (map.containsKey(diff)) {
                int length = i-map.get(diff);
                maxLength = Math.max(maxLength, length);
             }
             else map.put(diff, i);
        }
        return maxLength;
    }
}
