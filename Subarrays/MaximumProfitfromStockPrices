import java.util.*;
public class  MaximumProfitfromStockPrices {
    public static void main (String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i=0; i<n; i++){
            arr[i] = sc.nextInt();
        }
        int minprice = arr[0];
        int profit = 0;
        for(int i=0; i<n; i++) {
            int cost = arr[i]-minprice;
            profit= Math.max(profit,cost);
            minprice = Math.min(minprice,arr[i]);
        }
        System.out.println("Maxm profit= " +profit);
    }
}
